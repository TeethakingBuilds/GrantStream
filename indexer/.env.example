RPC_URL=wss://sepolia.base.org
CONTRACT_ADDRESS=0x...
DATABASE_URL=sqlite:./indexer.db

# Optional: block the contract was deployed at. If set, the indexer
# backfills all past MilestoneSubmitted events from here (or from the
# last indexed block on restart) up to the current chain head before
# switching to live subscription mode. If unset, backfill is skipped.
# DEPLOYMENT_BLOCK=12345678

# Optional: max block range per eth_getLogs call during backfill.
# Defaults to 2000 if unset. Lower this if your RPC provider rejects
# large ranges.
# BACKFILL_CHUNK_SIZE=2000
